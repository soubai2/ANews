# ANews local runtime configuration.
# Copy this file to .anews.env and fill in your own keys.
# .anews.env is local-only and should not be committed.

ANEWS_DB_PATH=anews.db

# DeepSeek is the preferred model provider.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=60

# Compatibility aliases are still supported if you already use them:
# OPENAI_API_KEY=
# OPENAI_MODEL=deepseek-v4-flash
# OPENAI_BASE_URL=https://api.deepseek.com
# ANEWS_AI_TIMEOUT_SECONDS=60

# Tavily is the first real search provider.
ANEWS_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# You may also use ANEWS_SEARCH_API_KEY instead of TAVILY_API_KEY.
# ANEWS_SEARCH_API_KEY=
ANEWS_SEARCH_BASE_URL=https://api.tavily.com/search
ANEWS_SEARCH_TIMEOUT_SECONDS=15

# Agent budgets. Tool calls control the model loop; search/read budgets control Tavily and URL work.
ANEWS_AGENT_MAX_TOOL_CALLS=16
ANEWS_AGENT_MAX_SEARCH_QUERIES=8
ANEWS_AGENT_MAX_READ_URLS=20
